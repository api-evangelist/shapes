          "name": "Create a chat completion with a Shape",
          "request": {
            "name": "Create a chat completion with a Shape",
            "description": {
              "content": "OpenAI-compatible chat completion. The `model` field selects the Shape as `shapesinc/<shape-username>`. Supports text plus a single `image_url` or `audio_url` content part. Streaming, system messages, message history, and parameter control (e.g. temperature) are not supported; personality and settings come from the Shape's shapes.inc configuration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "chat",
